@using WebAppSystems.Models.Enums;
@model WebAppSystems.Models.Client

@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="page-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-icon"><i class="bi bi-person-badge"></i></div>
            <div class="header-text">
                <h1 class="page-title">Cadastro de Cliente</h1>
                <p class="page-subtitle">Preencha os dados do novo cliente</p>
            </div>
        </div>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate id="formCreateCliente">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" name="forcar" id="forcarSalvar" value="false" />

            @if (ViewBag.ErroDuplicado != null)
            {
                <div class="alert alert-danger" style="display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:8px;background:#fee2e2;border:1px solid #fca5a5;color:#991b1b;margin-bottom:16px;">
                    <i class="bi bi-x-circle-fill" style="font-size:20px;flex-shrink:0;"></i>
                    <div style="flex:1;">
                        <strong>Bloqueado:</strong> @ViewBag.ErroDuplicado
                    </div>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                </div>
            }

            @if (ViewBag.AlertaDuplicado != null)
            {
                <div class="alert alert-warning" style="display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:8px;background:#fef3c7;border:1px solid #fcd34d;color:#92400e;margin-bottom:16px;">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size:20px;flex-shrink:0;"></i>
                    <div style="flex:1;">
                        <strong>Atenção:</strong> @ViewBag.AlertaDuplicado
                    </div>
                    <div style="display:flex;gap:8px;">
                        <button type="button" class="btn btn-warning btn-sm" onclick="confirmarDuplicado()" style="font-weight:600;">
                            <i class="bi bi-check-lg"></i> Sim, cadastrar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">
                            <i class="bi bi-x-lg"></i> Cancelar
                        </a>
                    </div>
                </div>
            }

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="Name">Nome</label>
                    <input asp-for="Name" class="form-control" id="clienteNome" style="text-transform:capitalize;" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Document">Documento (CPF/CNPJ) <span style="color:#e53e3e;">*</span></label>
                    <input asp-for="Document" class="form-control" placeholder="00.000.000/0000-00" required />
                    <span asp-validation-for="Document" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ImageData">Logo</label>
                    <input asp-for="ImageData" name="imageData" type="file" id="logoInput" class="form-control" accept="image/*" />
                    <div id="logoPreviewWrap" class="logo-preview-wrap" style="display:none;">
                        <img id="logoPreview" class="logo-preview" alt="Prévia da logo" />
                    </div>
                </div>
            </div>

            <div class="form-checks">
                <label class="check-item">
                    <input type="checkbox" asp-for="ClienteInterno" />
                    <span>Cliente Interno</span>
                </label>
                <label class="check-item">
                    <input type="checkbox" asp-for="ClienteInativo" />
                    <span>Cliente Inativo</span>
                </label>
            </div>

            <div class="solicitantes-box">
                <label class="solicitantes-title"><i class="bi bi-people"></i> Solicitantes</label>
                <p class="solicitantes-hint">Opcional. Pessoas que costumam solicitar trabalhos para este cliente. Clique na estrela para definir o padrão, sugerido ao selecionar o cliente nos lançamentos.</p>
                <input type="hidden" name="solicitantePadrao" id="solicitantePadraoCreate" value="" />
                <div class="solicitantes-add">
                    <input type="text" id="novoSolicitanteCreate" class="form-control" placeholder="Nome do solicitante" maxlength="100" />
                    <button type="button" id="btnAddSolicitanteCreate" class="btn-add-sol"><i class="bi bi-plus-circle"></i> Adicionar</button>
                </div>
                <ul id="solicitantesListCreate" class="solicitantes-ul"></ul>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save"><i class="bi bi-check-lg"></i> Salvar</button>
                <a asp-action="Index" class="btn-back"><i class="bi bi-arrow-left"></i> Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function confirmarDuplicado() {
            document.getElementById('forcarSalvar').value = 'true';
            document.getElementById('formCreateCliente').submit();
        }

        // Prévia da logo selecionada
        (function () {
            var input = document.getElementById('logoInput');
            var wrap = document.getElementById('logoPreviewWrap');
            var img = document.getElementById('logoPreview');
            if (!input) return;
            input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (file && file.type.startsWith('image/')) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        img.src = e.target.result;
                        wrap.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                } else {
                    img.src = '';
                    wrap.style.display = 'none';
                }
            });
        })();

        (function () {
            const inputEl = document.getElementById('novoSolicitanteCreate');
            const btnAdd = document.getElementById('btnAddSolicitanteCreate');
            const listEl = document.getElementById('solicitantesListCreate');
            const padraoEl = document.getElementById('solicitantePadraoCreate');
            const nomes = [];
            let padrao = '';

            function render() {
                listEl.innerHTML = '';
                // Se o padrão foi removido da lista, o cliente fica sem padrão
                if (padrao && !nomes.includes(padrao)) padrao = '';
                padraoEl.value = padrao;

                nomes.forEach(function (nome, index) {
                    const ehPadrao = nome === padrao;
                    const li = document.createElement('li');
                    li.className = 'solicitante-chip' + (ehPadrao ? ' is-padrao' : '');

                    // Estrela: define/remove o solicitante padrão (sugerido ao selecionar o cliente)
                    const btnPadrao = document.createElement('button');
                    btnPadrao.type = 'button';
                    btnPadrao.className = 'chip-star';
                    btnPadrao.title = ehPadrao ? 'Remover como padrão' : 'Definir como padrão';
                    btnPadrao.setAttribute('aria-label', btnPadrao.title);
                    btnPadrao.innerHTML = ehPadrao ? '<i class="bi bi-star-fill"></i>' : '<i class="bi bi-star"></i>';
                    btnPadrao.addEventListener('click', function () {
                        padrao = ehPadrao ? '' : nome;
                        render();
                    });

                    const label = document.createElement('span');
                    label.textContent = ehPadrao ? nome + ' (padrão)' : nome;

                    // Campo enviado junto com o formulário (model binding: List<string> solicitantes)
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'solicitantes';
                    hidden.value = nome;

                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.title = 'Remover';
                    btn.setAttribute('aria-label', 'Remover');
                    btn.innerHTML = '<i class="bi bi-x-lg"></i>';
                    btn.addEventListener('click', function () {
                        nomes.splice(index, 1);
                        render();
                    });

                    li.appendChild(btnPadrao);
                    li.appendChild(label);
                    li.appendChild(hidden);
                    li.appendChild(btn);
                    listEl.appendChild(li);
                });
            }

            function adicionar(nome) {
                nome = (nome || '').trim();
                if (!nome) return;
                const jaExiste = nomes.some(function (n) { return n.toLowerCase() === nome.toLowerCase(); });
                if (!jaExiste) {
                    nomes.push(nome);
                    // O primeiro solicitante já entra como padrão (o usuário pode trocar pela estrela)
                    if (nomes.length === 1) padrao = nome;
                }
                render();
            }

            btnAdd.addEventListener('click', function () {
                adicionar(inputEl.value);
                inputEl.value = '';
                inputEl.focus();
            });

            // Enter adiciona o nome sem enviar o formulário do cliente
            inputEl.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    adicionar(inputEl.value);
                    inputEl.value = '';
                }
            });

            // Restaura os nomes quando o formulário é reexibido pelo servidor (ex.: aviso de duplicidade)
            const iniciais = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (ViewBag.SolicitantesIniciais as List<string>) ?? new List<string>()));
            iniciais.forEach(adicionar);
            // Padrão restaurado depois dos nomes (o render descarta um padrão que não esteja na lista)
            padrao = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.SolicitantePadraoInicial as string) ?? ""));
            render();
        })();
    </script>
}

<style>
    /* Cabeçalho padrão (banner), igual ao Registro de Atividades */
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        padding: 24px 28px;
        margin-bottom: 24px;
        box-shadow: 0 6px 25px rgba(102, 126, 234, 0.25);
    }
    .page-header .header-content { display: flex; align-items: center; gap: 16px; }
    .page-header .header-icon {
        width: 50px; height: 50px; background: rgba(255,255,255,0.2); border-radius: 12px;
        display: flex; align-items: center; justify-content: center; font-size: 24px; color: #fff; flex-shrink: 0;
    }
    .page-header .header-text { flex: 1; }
    .page-header .page-title { font-size: 24px; font-weight: 700; color: #fff; margin: 0 0 6px 0; letter-spacing: -0.5px; }
    .page-header .page-subtitle { font-size: 14px; color: rgba(255,255,255,0.9); margin: 0; }

    .solicitantes-box { margin-top: 20px; padding-top: 16px; border-top: 1px solid #e2e8f0; }
    .solicitantes-title { font-size: 14px; font-weight: 600; color: #4a5568; display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .solicitantes-title i { color: #667eea; }
    .solicitantes-hint { font-size: 12px; color: #718096; margin: 0 0 10px; }
    .solicitantes-add { display: flex; gap: 10px; }
    .solicitantes-add .form-control { flex: 1; }
    .btn-add-sol { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .solicitantes-ul { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .solicitante-chip { display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px 6px 12px; background: #eef2ff; border: 1px solid #c7d2fe; border-radius: 16px; font-size: 13px; color: #3730a3; }
    .solicitante-chip button { background: transparent; border: none; color: #6366f1; cursor: pointer; padding: 0; line-height: 1; }
    .solicitante-chip button:hover { color: #e53e3e; }
    .logo-preview-wrap { margin-top: 10px; }
    .logo-preview { max-width: 140px; max-height: 140px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px; background: #fff; object-fit: contain; }
    .solicitante-chip .chip-star { color: #a0aec0; }
    .solicitante-chip .chip-star:hover { color: #d97706; }
    .solicitante-chip.is-padrao { background: #fffbeb; border-color: #fcd34d; color: #92400e; }
    .solicitante-chip.is-padrao .chip-star { color: #d97706; }
</style>
