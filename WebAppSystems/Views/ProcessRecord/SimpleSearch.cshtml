<!-- Área de impressão -->
<div id="areaImpressao" style="display:none;padding:40px;font-family:Arial,sans-serif;">
    <h2 id="printTitulo" style="color:#667eea;margin-bottom:8px;"></h2>
    <p id="printMeta" style="color:#718096;font-size:13px;margin-bottom:24px;"></p>
    <div id="printTexto" style="font-size:14px;line-height:1.8;color:#2d3748;border-left:4px solid #667eea;padding-left:16px;"></div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Sistema de múltipla seleção de clientes
    const clientSearch = document.getElementById('clientSearch');
    const clientList = document.getElementById('clientList');
    const selectedClientsDiv = document.getElementById('selectedClients');
    const clientIdsInput = document.getElementById('clientIds');
    let selectedClients = [];

    // Carregar clientes já selecionados (se houver)
    const preSelectedIds = clientIdsInput.value ? clientIdsInput.value.split(',').filter(x => x.trim()) : [];
    if (preSelectedIds.length > 0) {
        preSelectedIds.forEach(id => {
            const option = Array.from(clientList.options).find(opt => opt.getAttribute('data-id') === id.trim());
            if (option) {
                selectedClients.push({ id: id.trim(), name: option.value });
            }
        });
        renderSelectedClients();
        atualizarBotaoResumoIA();
    }

    // Adicionar cliente ao selecionar
    clientSearch.addEventListener('change', function() {
        const selectedOption = Array.from(clientList.options).find(option => option.value === this.value);
        if (selectedOption) {
            const clientId = selectedOption.getAttribute('data-id');
            const clientName = selectedOption.value;
            if (!selectedClients.find(c => c.id === clientId)) {
                selectedClients.push({ id: clientId, name: clientName });
                renderSelectedClients();
                updateHiddenInput();
                atualizarBotaoResumoIA();
            }
        }
        this.value = '';
    });

    // Renderizar tags de clientes selecionados
    function renderSelectedClients() {
        selectedClientsDiv.innerHTML = '';
        selectedClients.forEach(client => {
            const tag = document.createElement('div');
            tag.className = 'client-tag';
            tag.innerHTML = `<span>${client.name}</span><span class="remove-client" onclick="removeClient('${client.id}')">×</span>`;
            selectedClientsDiv.appendChild(tag);
        });
    }

    // Remover cliente
    window.removeClient = function(clientId) {
        selectedClients = selectedClients.filter(c => c.id !== clientId);
        renderSelectedClients();
        updateHiddenInput();
        atualizarBotaoResumoIA();
    };

    // Atualizar campo hidden
    function updateHiddenInput() {
        clientIdsInput.value = selectedClients.map(c => c.id).join(',');
    }

    // Controla visibilidade do botão IA (só com 1 cliente)
    function atualizarBotaoResumoIA() {
        const btn = document.getElementById('btnResumoIA');
        if (btn) btn.style.display = selectedClients.length === 1 ? 'inline-flex' : 'none';
    }

    // Autocomplete para Usuário
    const attorneySearch = document.getElementById('attorneySearch');
    const attorneyIdInput = document.getElementById('attorneyId');
    const attorneyList = document.getElementById('attorneyList');

    if (attorneyIdInput.value) {
        const selectedAttorneyOption = Array.from(attorneyList.options).find(opt => opt.getAttribute('data-id') === attorneyIdInput.value);
        if (selectedAttorneyOption) attorneySearch.value = selectedAttorneyOption.value;
    }

    attorneySearch.addEventListener('input', function() {
        const selectedOption = Array.from(attorneyList.options).find(option => option.value === this.value);
        attorneyIdInput.value = selectedOption ? selectedOption.getAttribute('data-id') || '' : '';
    });

    // Inicializar botão IA
    atualizarBotaoResumoIA();

    // Sistema de Paginação + Filtro dinâmico
    const table = document.getElementById('resultsTable');
    if (table) {
        const tbody = table.querySelector('tbody');
        const allRows = Array.from(tbody.querySelectorAll('tr'));
        const pageSizeSelect = document.getElementById('pageSize');
        const firstPageBtn = document.getElementById('firstPage');
        const prevPageBtn = document.getElementById('prevPage');
        const nextPageBtn = document.getElementById('nextPage');
        const lastPageBtn = document.getElementById('lastPage');
        const currentPageSpan = document.getElementById('currentPage');
        const totalPagesSpan = document.getElementById('totalPages');
        const currentStartSpan = document.getElementById('currentStart');
        const currentEndSpan = document.getElementById('currentEnd');
        const totalRecordsSpan = document.getElementById('totalRecords');
        const searchInput = document.getElementById('tableSearch');
        const searchCount = document.getElementById('tableSearchCount');
        const clearBtn = document.getElementById('btnClearSearch');

        let currentPage = 1;
        let pageSize = 10;
        let filteredRows = allRows;

        // Filtro dinâmico
        searchInput.addEventListener('input', function () {
            currentPage = 1;
            applyFilter();
        });

        function applyFilter() {
            const term = searchInput.value.trim().toLowerCase();
            clearBtn.style.display = term ? 'inline-flex' : 'none';

            if (!term) {
                filteredRows = allRows;
                // Remove highlights
                allRows.forEach(r => {
                    r.querySelectorAll('mark.search-hl').forEach(m => {
                        m.replaceWith(document.createTextNode(m.textContent));
                    });
                });
            } else {
                filteredRows = allRows.filter(r => {
                    const searchData = r.getAttribute('data-search') || '';
                    return searchData.includes(term);
                });

                // Highlight na coluna descrição
                allRows.forEach(r => {
                    const descCell = r.querySelector('.col-descricao');
                    if (!descCell) return;
                    // Remove highlight anterior
                    descCell.querySelectorAll('mark.search-hl').forEach(m => m.replaceWith(document.createTextNode(m.textContent)));
                    const originalText = r.getAttribute('data-descricao') || '';
                    if (!term || !originalText.toLowerCase().includes(term)) {
                        descCell.textContent = originalText;
                        return;
                    }
                    // Aplica highlight
                    const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
                    descCell.innerHTML = originalText.replace(regex, '<mark class="search-hl">$1</mark>');
                });
            }

            const total = filteredRows.length;
            searchCount.textContent = term ? `${total} resultado${total !== 1 ? 's' : ''}` : '';
            renderPage();
        }

        function renderPage() {
            const start = (currentPage - 1) * pageSize;
            const end = start + pageSize;
            const total = filteredRows.length;
            const totalPages = Math.max(1, Math.ceil(total / pageSize));

            // Esconde todas, mostra só as filtradas na página atual
            allRows.forEach(r => r.style.display = 'none');
            filteredRows.forEach((r, i) => {
                r.style.display = (i >= start && i < end) ? '' : 'none';
            });

            currentPageSpan.textContent = currentPage;
            totalPagesSpan.textContent = totalPages;
            currentStartSpan.textContent = total > 0 ? start + 1 : 0;
            currentEndSpan.textContent = Math.min(end, total);
            totalRecordsSpan.textContent = total;

            firstPageBtn.disabled = currentPage === 1;
            prevPageBtn.disabled = currentPage === 1;
            nextPageBtn.disabled = currentPage >= totalPages;
            lastPageBtn.disabled = currentPage >= totalPages;
        }

        function updatePagination() {
            pageSize = parseInt(pageSizeSelect.value);
            currentPage = 1;
            renderPage();
        }

        pageSizeSelect.addEventListener('change', updatePagination);
        firstPageBtn.addEventListener('click', () => { currentPage = 1; renderPage(); });
        prevPageBtn.addEventListener('click', () => { if (currentPage > 1) { currentPage--; renderPage(); } });
        nextPageBtn.addEventListener('click', () => { const tp = Math.ceil(filteredRows.length / pageSize); if (currentPage < tp) { currentPage++; renderPage(); } });
        lastPageBtn.addEventListener('click', () => { currentPage = Math.ceil(filteredRows.length / pageSize); renderPage(); });

        renderPage();
    }

    window.limparFiltro = function() {
        const input = document.getElementById('tableSearch');
        input.value = '';
        input.dispatchEvent(new Event('input'));
        input.focus();
    };

}); // fim DOMContentLoaded

    // ---- Ignorar registros ----
    function toggleIgnorar(checkbox) {
        const row = checkbox.closest('tr');
        const id = checkbox.dataset.id;
        row.classList.toggle('ignorado', checkbox.checked);

        // Atualiza o campo hidden com os IDs ignorados
        const ignoredInput = document.getElementById('ignoredIds');
        const current = ignoredInput.value ? ignoredInput.value.split(',').filter(x => x) : [];
        if (checkbox.checked) {
            if (!current.includes(id)) current.push(id);
        } else {
            const idx = current.indexOf(id);
            if (idx > -1) current.splice(idx, 1);
        }
        ignoredInput.value = current.join(',');

        // Recalcula o total de horas excluindo os ignorados
        recalcularTotal();
    }

    function recalcularTotal() {
        const badgeEl = document.querySelector('.badge-value');
        if (!badgeEl) return;

        let totalMin = 0;
        document.querySelectorAll('#resultsTable tbody tr').forEach(row => {
            if (row.classList.contains('ignorado')) return;
            const min = parseInt(row.getAttribute('data-minutos') || '0');
            totalMin += min;
        });

        const h = Math.floor(totalMin / 60);
        const m = totalMin % 60;
        const formatted = `${h}:${String(m).padStart(2, '0')}`;
        badgeEl.textContent = formatted;

        // Animação sutil no badge
        badgeEl.closest('.total-hours-badge')?.classList.add('badge-updated');
        setTimeout(() => badgeEl.closest('.total-hours-badge')?.classList.remove('badge-updated'), 400);
    }

    // ---- Resumo Executivo IA ----

    // Dispara geração quando o modal termina de abrir
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('resumoIAModal')?.addEventListener('shown.bs.modal', gerarResumoIA);
    });

    // Dados do resumo gerado (para PDF)
    let dadosResumoAtual = null;

    async function gerarResumoIA() {
        const textoEl = document.getElementById('resumoTexto');
        const metaEl = document.getElementById('resumoMeta');
        const btnPDF = document.getElementById('btnGerarPDF');
        btnPDF.disabled = true;
        dadosResumoAtual = null;
        textoEl.innerHTML = '<div style="text-align:center;padding:30px;color:#667eea;"><i class="bi bi-arrow-repeat" style="font-size:2rem;animation:spin 1s linear infinite;display:inline-block;"></i><p style="margin-top:12px;">Analisando dados...</p></div>';
        metaEl.textContent = '';

        const clientIds = document.getElementById('clientIds')?.value || '';
        const minDate = document.getElementById('minDate')?.value || '';
        const maxDate = document.getElementById('maxDate')?.value || '';
        const clientId = parseInt(clientIds.split(',')[0]);

        // Coletar dados da tabela de resultados — TODOS os registros, não só os visíveis
        const rows = document.querySelectorAll('#resultsTable tbody tr');
        const registros = [];
        let totalMin = 0;
        rows.forEach(row => {
            // Pular registros marcados como ignorar
            if (row.classList.contains('ignorado')) return;

            const cells = row.querySelectorAll('td');
            if (cells.length < 4) return;
            const horas = cells[3]?.textContent?.trim() || '';
            const match = horas.match(/(\d+):(\d+)/);
            if (match) totalMin += parseInt(match[1]) * 60 + parseInt(match[2]);
            registros.push({
                data: cells[0]?.textContent?.trim() || '',
                advogado: cells[1]?.textContent?.trim() || '',
                descricao: row.getAttribute('data-descricao') || '',
                horas: horas,
                tipo: cells[6]?.textContent?.trim() || ''
            });
        });

        const clienteNome = document.querySelector('.client-tag span')?.textContent?.trim() || 'Cliente';
        const totalH = Math.floor(totalMin / 60);
        const totalM = totalMin % 60;
        const totalHoras = `${totalH}:${String(totalM).padStart(2,'0')}h`;
        const periodo = `${minDate} a ${maxDate}`;

        metaEl.textContent = `${clienteNome} | ${periodo} | Total: ${totalHoras}`;

        try {
            const resp = await fetch('/ProcessRecord/GerarResumoExecutivo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    cliente: clienteNome,
                    periodo: periodo,
                    totalHoras: totalHoras,
                    registros: registros
                })
            });

            const result = await resp.json();

            if (resp.ok && result.resumo) {
                textoEl.innerHTML = `<div style="font-size:14px;line-height:1.8;color:#2d3748;white-space:pre-wrap;">${result.resumo}</div>`;
                // Guardar dados para o PDF
                dadosResumoAtual = {
                    cliente: clienteNome,
                    periodo: periodo,
                    totalHoras: totalHoras,
                    resumo: result.resumo,
                    registros: registros
                };
                btnPDF.disabled = false;
            } else {
                let errorMessage = result.erro || 'Erro desconhecido';
                let errorStyle = 'background:#fed7d7;color:#822727;padding:16px;border-radius:8px;font-size:14px;';
                if (resp.status === 429) {
                    errorStyle = 'background:linear-gradient(135deg,#fff5f5,#fed7d7);border:2px solid #f5576c;color:#2d3748;padding:24px;border-radius:12px;font-size:14px;text-align:center;';
                    errorMessage = `<i class="bi bi-exclamation-triangle" style="font-size:2rem;color:#f5576c;"></i><h5 style="color:#f5576c;margin:12px 0;">Limite Diário Atingido!</h5><p>${result.erro}</p>`;
                } else if (resp.status === 503) {
                    errorStyle = 'background:#fff3cd;border:1px solid #ffc107;color:#856404;padding:16px;border-radius:8px;font-size:14px;text-align:center;';
                    errorMessage = `<i class="bi bi-gear" style="font-size:2rem;"></i><h5 style="margin:8px 0;">IA não configurada</h5><p>${result.erro}</p>`;
                }
                textoEl.innerHTML = `<div style="${errorStyle}">${errorMessage}</div>`;
            }
        } catch (e) {
            textoEl.innerHTML = `<div style="background:#fed7d7;color:#822727;padding:16px;border-radius:8px;">Erro: ${e.message}</div>`;
        }
    }

    function imprimirResumo() {
        document.getElementById('areaImpressao').style.display = 'block';
        window.print();
        document.getElementById('areaImpressao').style.display = 'none';
    }

    async function gerarPDF() {
        if (!dadosResumoAtual) return;
        const btn = document.getElementById('btnGerarPDF');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Gerando...';
        try {
            const resp = await fetch('/ProcessRecord/GerarResumoExecutivoPDF', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    ...dadosResumoAtual,
                    clienteId: parseInt(document.getElementById('clientIds')?.value?.split(',')[0] || '0')
                })
            });
            if (resp.ok) {
                const blob = await resp.blob();
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Resumo_Executivo_${dadosResumoAtual.cliente.replace(/\s+/g,'_')}.pdf`;
                a.click();
                URL.revokeObjectURL(url);
            } else {
                const data = await resp.json();
                alert('Erro ao gerar PDF: ' + (data.erro || resp.status));
            }
        } catch(e) {
            alert('Erro: ' + e.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-file-earmark-pdf me-1"></i>Baixar PDF';
        }
    }
</script>

