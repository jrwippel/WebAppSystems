            </div>
            <div class="modal-body">
                <p id="resumoMeta" class="text-muted small mb-3"></p>
                <div id="resumoTexto" class="p-3 rounded" style="background:#f7fafc;border-left:4px solid #667eea;font-size:14px;line-height:1.9;min-height:120px;white-space:pre-wrap;max-height:60vh;overflow-y:auto;">
