@{
    ViewData["Title"] = "Unificar Clientes";
}

<div class="uni-container">
    <div class="page-header">
        <div class="header-left">
            <div class="header-icon"><i class="bi bi-union"></i></div>
            <div class="header-text">
                <h1 class="page-title">Unificar Clientes</h1>
                <p class="page-subtitle">Mova todos os lançamentos e registros de um cliente de origem para um cliente de destino</p>
            </div>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert-box alert-success"><i class="bi bi-check-circle"></i> @TempData["MensagemSucesso"]</div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert-box alert-error"><i class="bi bi-x-circle"></i> @TempData["MensagemErro"]</div>
    }

    <div class="info-note">
        <i class="bi bi-info-circle"></i>
        <span>
            Selecione o <strong>cliente de origem</strong> (que terá os registros movidos) e o <strong>cliente de destino</strong>.
            Após mover, <strong>inative manualmente</strong> o cliente de origem se ele não for mais usado.
            Clientes com lançamentos em <strong>faturamento ou aprovação</strong> não podem ser usados como origem.
        </span>
    </div>

    <div class="uni-grid">
        <!-- ORIGEM -->
        <div class="uni-card">
            <div class="uni-card-title origem"><i class="bi bi-box-arrow-right"></i> Cliente de Origem</div>
            <div class="combo-wrap">
                <input type="text" id="buscaOrigem" class="combo-input" placeholder="Digite o nome ou documento..." autocomplete="off" />
                <div class="combo-panel" id="panelOrigem"></div>
            </div>
            <div class="resumo" id="resumoOrigem"></div>
        </div>

        <!-- DESTINO -->
        <div class="uni-card">
            <div class="uni-card-title destino"><i class="bi bi-box-arrow-in-down"></i> Cliente de Destino</div>
            <div class="combo-wrap">
                <input type="text" id="buscaDestino" class="combo-input" placeholder="Digite o nome ou documento..." autocomplete="off" />
                <div class="combo-panel" id="panelDestino"></div>
            </div>
            <div class="resumo" id="resumoDestino"></div>
        </div>
    </div>

    <div class="acao-area">
        <div class="previa" id="previaMover"></div>
        <button type="button" id="btnMover" class="btn-mover" disabled>
            <i class="bi bi-arrow-right-circle"></i> Mover registros
        </button>
    </div>
</div>

<form id="formMover" method="post" asp-action="Mover" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="origemId" id="hdnOrigem" />
    <input type="hidden" name="destinoId" id="hdnDestino" />
</form>

<style>
    .uni-container { max-width: 1100px; margin: 0 auto; padding: 20px; }
    .page-header { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); border-radius: 12px; padding: 22px 26px; margin-bottom: 18px; }
    .header-left { display: flex; align-items: center; gap: 16px; }
    .header-icon { width: 48px; height: 48px; background: rgba(255,255,255,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #fff; }
    .page-title { font-size: 22px; font-weight: 700; color: #fff; margin: 0 0 4px; }
    .page-subtitle { font-size: 13px; color: rgba(255,255,255,0.9); margin: 0; }

    .alert-box { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 14px; }
    .alert-success { background: #f0fff4; border: 1px solid #9ae6b4; color: #276749; }
    .alert-error { background: #fff5f5; border: 1px solid #feb2b2; color: #c53030; }

    .info-note { display: flex; gap: 10px; background: #ebf4ff; border-left: 4px solid #667eea; border-radius: 6px; padding: 12px 16px; font-size: 13px; color: #2d3748; margin-bottom: 20px; }
    .info-note i { color: #667eea; font-size: 18px; flex-shrink: 0; }

    .uni-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    @@media (max-width: 760px) { .uni-grid { grid-template-columns: 1fr; } }

    .uni-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); padding: 18px; }
    .uni-card-title { font-size: 14px; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
    .uni-card-title.origem { color: #c05621; }
    .uni-card-title.destino { color: #2b6cb0; }

    .combo-wrap { position: relative; }
    .combo-input { width: 100%; padding: 10px 14px; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 14px; }
    .combo-input:focus { outline: none; border-color: #667eea; }
    .combo-panel { position: absolute; z-index: 50; left: 0; right: 0; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,0.12); margin-top: 4px; max-height: 260px; overflow-y: auto; display: none; }
    .combo-item { padding: 9px 14px; font-size: 13px; cursor: pointer; }
    .combo-item:hover { background: #eef2ff; }
    .combo-item small { color: #718096; }

    .resumo { margin-top: 14px; font-size: 13px; color: #4a5568; }
    .resumo-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #f7fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; cursor: pointer; }
    .resumo-head strong { color: #2d3748; }
    .resumo-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .rb { background: #edf2f7; border-radius: 10px; padding: 2px 10px; font-size: 12px; color: #4a5568; }
    .rb-bloqueio { background: #fed7d7; color: #c53030; }
    .detalhes { margin-top: 10px; max-height: 260px; overflow-y: auto; border: 1px solid #edf2f7; border-radius: 8px; display: none; }
    .detalhes table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .detalhes th { position: sticky; top: 0; background: #f7fafc; text-align: left; padding: 8px 10px; border-bottom: 1px solid #e2e8f0; }
    .detalhes td { padding: 7px 10px; border-bottom: 1px solid #f1f5f9; }
    .det-bloqueado { color: #c53030; }

    .acao-area { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 20px; background: #fff; border-radius: 12px; padding: 16px 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); }
    .previa { font-size: 13px; color: #4a5568; }
    .previa.erro { color: #c53030; }
    .btn-mover { display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .btn-mover:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script>
    (function () {
        const urls = {
            buscar: '@Url.Action("BuscarClientes", "ClientesDuplicados")',
            resumo: '@Url.Action("Resumo", "ClientesDuplicados")',
            detalhes: '@Url.Action("Detalhes", "ClientesDuplicados")',
            previa: '@Url.Action("Previa", "ClientesDuplicados")'
        };

        const selecao = { origem: null, destino: null };

        function debounce(fn, ms) {
            let t;
            return function () { clearTimeout(t); const a = arguments, c = this; t = setTimeout(() => fn.apply(c, a), ms); };
        }

        function montarCombo(tipo, inputId, panelId, resumoId) {
            const input = document.getElementById(inputId);
            const panel = document.getElementById(panelId);
            const resumoEl = document.getElementById(resumoId);

            const buscar = debounce(function () {
                const termo = input.value.trim();
                fetch(urls.buscar + '?termo=' + encodeURIComponent(termo))
                    .then(r => r.json())
                    .then(function (lista) {
                        panel.innerHTML = '';
                        if (!lista.length) { panel.style.display = 'none'; return; }
                        lista.forEach(function (c) {
                            const item = document.createElement('div');
                            item.className = 'combo-item';
                            const doc = c.documento ? ' — ' + c.documento : '';
                            const inativo = c.inativo ? ' (inativo)' : '';
                            item.innerHTML = '<strong>' + c.nome + '</strong><small>' + doc + inativo + '</small>';
                            item.addEventListener('mousedown', function (e) {
                                e.preventDefault();
                                input.value = c.nome;
                                panel.style.display = 'none';
                                selecionar(tipo, c.id, resumoEl);
                            });
                            panel.appendChild(item);
                        });
                        panel.style.display = 'block';
                    });
            }, 250);

            input.addEventListener('input', function () {
                selecao[tipo] = null;
                resumoEl.innerHTML = '';
                atualizarAcao();
                buscar();
            });
            input.addEventListener('blur', function () { setTimeout(() => panel.style.display = 'none', 150); });
        }

        function selecionar(tipo, clienteId, resumoEl) {
            fetch(urls.resumo + '?clienteId=' + clienteId)
                .then(r => r.json())
                .then(function (d) {
                    if (!d.sucesso) { resumoEl.innerHTML = '<span class="previa erro">' + (d.mensagem || 'Erro') + '</span>'; return; }
                    selecao[tipo] = { id: d.clienteId, nome: d.nome, bloqueados: d.lancamentosBloqueados };

                    // Discrimina cada tipo de vínculo (mostra só os que têm quantidade > 0)
                    const vinculos = [
                        { n: d.valores, label: 'valor(es)' },
                        { n: d.percentuaisArea, label: 'percentual(is) de área' },
                        { n: d.mensalistas, label: 'mensalista(s)' },
                        { n: d.lotes, label: 'lote(s) de faturamento' },
                        { n: d.documentos, label: 'documento(s)' },
                        { n: d.solicitantes, label: 'solicitante(s)' }
                    ];
                    let badgesVinculos = vinculos
                        .filter(v => v.n > 0)
                        .map(v => '<span class="rb">' + v.n + ' ' + v.label + '</span>')
                        .join('');
                    if (!badgesVinculos) badgesVinculos = '<span class="rb">Nenhum outro vínculo</span>';

                    const bloqueioBadge = d.lancamentosBloqueados > 0
                        ? '<span class="rb rb-bloqueio"><i class="bi bi-lock"></i> ' + d.lancamentosBloqueados + ' em faturamento</span>' : '';

                    resumoEl.innerHTML =
                        '<div class="resumo-head" data-cliente="' + d.clienteId + '">' +
                            '<span><strong>' + d.totalLancamentos + '</strong> lançamento(s) &middot; <strong>' + d.totalHoras + '</strong> h</span>' +
                            '<span style="color:#667eea;font-size:12px;">ver detalhes <i class="bi bi-chevron-down"></i></span>' +
                        '</div>' +
                        '<div class="resumo-badges">' + badgesVinculos + bloqueioBadge + '</div>' +
                        '<div class="detalhes"></div>';

                    const head = resumoEl.querySelector('.resumo-head');
                    const det = resumoEl.querySelector('.detalhes');
                    head.addEventListener('click', function () {
                        if (det.style.display === 'block') { det.style.display = 'none'; return; }
                        if (!det.dataset.carregado) {
                            det.innerHTML = '<div style="padding:10px;color:#718096;">Carregando...</div>';
                            det.style.display = 'block';
                            fetch(urls.detalhes + '?clienteId=' + d.clienteId)
                                .then(r => r.json())
                                .then(function (itens) {
                                    if (!itens.length) { det.innerHTML = '<div style="padding:10px;color:#718096;">Sem lançamentos.</div>'; return; }
                                    let html = '<table><thead><tr><th>Data</th><th>Horas</th><th>Advogado</th><th>Descrição</th></tr></thead><tbody>';
                                    itens.forEach(function (i) {
                                        html += '<tr class="' + (i.bloqueado ? 'det-bloqueado' : '') + '"><td>' + i.data + '</td><td>' + i.horas + '</td><td>' + i.advogado + '</td><td>' + i.descricao + '</td></tr>';
                                    });
                                    html += '</tbody></table>';
                                    det.innerHTML = html;
                                    det.dataset.carregado = '1';
                                });
                        } else {
                            det.style.display = 'block';
                        }
                    });

                    atualizarAcao();
                });
        }

        function atualizarAcao() {
            const previaEl = document.getElementById('previaMover');
            const btn = document.getElementById('btnMover');
            btn.disabled = true;
            previaEl.textContent = '';
            previaEl.classList.remove('erro');

            if (!selecao.origem || !selecao.destino) return;
            if (selecao.origem.id === selecao.destino.id) {
                previaEl.textContent = 'A origem e o destino devem ser diferentes.';
                previaEl.classList.add('erro');
                return;
            }

            fetch(urls.previa + '?origemId=' + selecao.origem.id + '&destinoId=' + selecao.destino.id)
                .then(r => r.json())
                .then(function (d) {
                    if (!d.sucesso || d.bloqueado) {
                        previaEl.textContent = d.mensagem || 'Não é possível mover.';
                        previaEl.classList.add('erro');
                        return;
                    }
                    previaEl.innerHTML = 'Mover de <strong>' + d.clienteDuplicadoNome + '</strong> para <strong>' + d.clienteCorretoNome + '</strong>: ' +
                        d.lancamentos + ' lançamento(s), ' + d.valores + ' valor(es), ' + d.percentuaisArea + ' percentual(is), ' +
                        d.mensalistas + ' mensalista(s), ' + d.lotes + ' lote(s), ' + d.documentos + ' documento(s), ' + d.solicitantes + ' solicitante(s).';
                    btn.disabled = false;
                });
        }

        montarCombo('origem', 'buscaOrigem', 'panelOrigem', 'resumoOrigem');
        montarCombo('destino', 'buscaDestino', 'panelDestino', 'resumoDestino');

        document.getElementById('btnMover').addEventListener('click', function () {
            if (!selecao.origem || !selecao.destino) return;
            if (!confirm('Mover todos os registros de "' + selecao.origem.nome + '" para "' + selecao.destino.nome + '"?\n\nDepois, inative o cliente de origem se ele não for mais usado.')) return;
            document.getElementById('hdnOrigem').value = selecao.origem.id;
            document.getElementById('hdnDestino').value = selecao.destino.id;
            document.getElementById('formMover').submit();
        });
    })();
</script>
