@using WebAppSystems.Models.Enums;
@using WebAppSystems.Models.ViewModels;
@model AttorneyFormViewModel

@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="page-container">
    <div class="page-header">
        <div class="page-header-icon"><i class="bi bi-person-plus"></i></div>
        <div>
            <h2>Cadastro de Usuário</h2>
            <p>Preencha os dados do novo usuário</p>
        </div>
    </div>

    <div class="form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="Attorney.Name">Nome</label>
                    <input asp-for="Attorney.Name" class="form-control" />
                    <span asp-validation-for="Attorney.Name" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Attorney.Email">Email</label>
                    <input asp-for="Attorney.Email" class="form-control" />
                    <span asp-validation-for="Attorney.Email" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Attorney.BirthDate">Data de Nascimento</label>
                    <input asp-for="Attorney.BirthDate" class="form-control" type="date" />
                </div>
                <div class="form-field">
                    <label asp-for="Attorney.Phone">Telefone</label>
                    <input asp-for="Attorney.Phone" class="form-control" />
                </div>
                <div class="form-field">
                    <label asp-for="Attorney.DepartmentId">Área</label>
                    <select asp-for="Attorney.DepartmentId" asp-items="@(new SelectList(Model.Departments,"Id","Name"))" class="form-control"></select>
                </div>
                <div class="form-field">
                    <label asp-for="Attorney.Login">Login</label>
                    <input asp-for="Attorney.Login" class="form-control" />
                    <span asp-validation-for="Attorney.Login" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label>Perfil</label>
                    <select asp-for="Attorney.Perfil" class="form-control">
                        <option value="">Selecione</option>
                        <option value="@ProfileEnum.Admin">Administrador</option>
                        <option value="@ProfileEnum.Padrao">Padrão</option>
                        <option value="@ProfileEnum.Controladoria">Controladoria</option>
                    </select>
                </div>
                <div class="form-field">
                    <label>Senha</label>
                    <input type="password" asp-for="Attorney.Password" class="form-control" placeholder="Digite a senha" />
                </div>
            </div>

            @if (ViewBag.CurrentUserPerfil == ProfileEnum.Admin)
            {
                <div class="form-section-approval">
                    <h3><i class="bi bi-check2-square"></i> Fluxo de Aprovação de Faturamento</h3>
                    <div class="alert alert-info" style="background: #e6f7ff; border: 1px solid #91d5ff; border-radius: 6px; padding: 10px; margin-bottom: 15px; font-size: 13px;">
                        <i class="bi bi-info-circle" style="color: #1890ff;"></i>
                        Selecione apenas uma opção. Usuários Financeiros criam lotes de aprovação, e Aprovadores revisam e aprovam os lotes.
                    </div>
                    
                    <div class="radio-group-create">
                        <label class="radio-item">
                            <input type="radio" name="ApprovalRole" value="none" checked onchange="updateApprovalFlagsCreate(this.value)">
                            <div class="radio-content">
                                <i class="bi bi-dash-circle"></i>
                                <div>
                                    <strong>Nenhuma</strong>
                                    <span>Não participa do fluxo</span>
                                </div>
                            </div>
                        </label>
                        
                        <label class="radio-item">
                            <input type="radio" name="ApprovalRole" value="financeiro" onchange="updateApprovalFlagsCreate(this.value)">
                            <div class="radio-content">
                                <i class="bi bi-cash-stack"></i>
                                <div>
                                    <strong>Financeiro</strong>
                                    <span>Cria lotes de aprovação</span>
                                </div>
                            </div>
                        </label>
                        
                        <label class="radio-item">
                            <input type="radio" name="ApprovalRole" value="aprovador" onchange="updateApprovalFlagsCreate(this.value)">
                            <div class="radio-content">
                                <i class="bi bi-check-circle"></i>
                                <div>
                                    <strong>Aprovador</strong>
                                    <span>Revisa e aprova lotes</span>
                                </div>
                            </div>
                        </label>
                    </div>
                    
                    <input type="hidden" asp-for="Attorney.IsFinanceiro" id="hiddenIsFinanceiro" value="false" />
                    <input type="hidden" asp-for="Attorney.IsAprovador" id="hiddenIsAprovador" value="false" />
                </div>
            }

            <div class="form-checks">
                <label class="check-item">
                    <input type="checkbox" asp-for="Attorney.UseBorder" />
                    <span>Utiliza borda</span>
                </label>
                <label class="check-item">
                    <input type="checkbox" asp-for="Attorney.UseCronometroAlwaysOnTop" />
                    <span>Cronômetro Always on Top</span>
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save"><i class="bi bi-check-lg"></i> Salvar</button>
                <a asp-action="Index" class="btn-back"><i class="bi bi-arrow-left"></i> Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    
    <script>
        function updateApprovalFlagsCreate(role) {
            const isFinanceiro = document.getElementById('hiddenIsFinanceiro');
            const isAprovador = document.getElementById('hiddenIsAprovador');
            
            switch(role) {
                case 'financeiro':
                    isFinanceiro.value = 'true';
                    isAprovador.value = 'false';
                    break;
                case 'aprovador':
                    isFinanceiro.value = 'false';
                    isAprovador.value = 'true';
                    break;
                default: // 'none'
                    isFinanceiro.value = 'false';
                    isAprovador.value = 'false';
                    break;
            }
        }
    </script>
}

<style>
    .form-section-approval {
        margin: 25px 0;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
    }

    .form-section-approval h3 {
        font-size: 16px;
        font-weight: 600;
        color: #2d3748;
        margin: 0 0 15px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-section-approval h3 i {
        color: #667eea;
    }

    .radio-group-create {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
    }

    .radio-item {
        position: relative;
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        padding: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: block;
    }

    .radio-item:hover {
        border-color: #cbd5e0;
        background: #f7fafc;
    }

    .radio-item:has(input:checked) {
        background: rgba(102, 126, 234, 0.05);
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .radio-item input[type="radio"] {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #667eea;
    }

    .radio-content {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding-right: 28px;
    }

    .radio-content i {
        font-size: 22px;
        color: #667eea;
        flex-shrink: 0;
    }

    .radio-content div {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .radio-content strong {
        font-size: 13px;
        font-weight: 600;
        color: #2d3748;
    }

    .radio-content span {
        font-size: 11px;
        color: #718096;
        line-height: 1.3;
    }
</style>

