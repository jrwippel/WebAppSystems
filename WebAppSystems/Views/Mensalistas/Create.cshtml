@model WebAppSystems.Models.Mensalista

@{
    ViewData["Title"] = "Novo Mensalista";
}

<div class="page-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-icon"><i class="bi bi-calendar-check"></i></div>
            <div class="header-text">
                <h1 class="page-title">Cadastro de Mensalista</h1>
                <p class="page-subtitle">Defina os valores mensais por cliente</p>
            </div>
        </div>
    </div>

    <div class="form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-field">
                <label asp-for="ClientId">Cliente</label>
                <select asp-for="ClientId" class="form-control" asp-items="ViewBag.Clients" id="clienteSelect"></select>
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="ValorMensalBruto">Valor Mensal Bruto (R$)</label>
                    <input asp-for="ValorMensalBruto" class="form-control" pattern="^[0-9]+([.,][0-9]{1,2})?$" data-val="false" placeholder="0,00" />
                    <span asp-validation-for="ValorMensalBruto" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ValorHoraVirtual">Valor Hora Virtual (R$) <small style="color:#718096;">(opcional - calculado automaticamente)</small></label>
                    <input asp-for="ValorHoraVirtual" class="form-control" pattern="^[0-9]+([.,][0-9]{1,2})?$" data-val="false" placeholder="Auto: 300~350" />
                    <span asp-validation-for="ValorHoraVirtual" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ComissaoParceiro">Comissão Parceiro (R$)</label>
                    <input asp-for="ComissaoParceiro" class="form-control" pattern="^[0-9]+([.,][0-9]{1,2})?$" data-val="false" placeholder="0,00" />
                    <span asp-validation-for="ComissaoParceiro" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ComissaoSocio">Comissão Sócio (R$)</label>
                    <input asp-for="ComissaoSocio" class="form-control" pattern="^[0-9]+([.,][0-9]{1,2})?$" data-val="false" placeholder="0,00" />
                    <span asp-validation-for="ComissaoSocio" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save"><i class="bi bi-check-lg"></i> Salvar</button>
                <a asp-action="Index" class="btn-back"><i class="bi bi-arrow-left"></i> Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(document).ready(function () {
            $("#clienteSelect").select2({ placeholder: "Selecione um cliente", allowClear: true });
        });
    </script>
}

<style>
    /* Cabeçalho padrão (banner), igual ao Registro de Atividades */
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        padding: 24px 28px;
        margin-bottom: 24px;
        box-shadow: 0 6px 25px rgba(102, 126, 234, 0.25);
    }
    .page-header .header-content { display: flex; align-items: center; gap: 16px; }
    .page-header .header-icon {
        width: 50px; height: 50px; background: rgba(255,255,255,0.2); border-radius: 12px;
        display: flex; align-items: center; justify-content: center; font-size: 24px; color: #fff; flex-shrink: 0;
    }
    .page-header .header-text { flex: 1; }
    .page-header .page-title { font-size: 24px; font-weight: 700; color: #fff; margin: 0 0 6px 0; letter-spacing: -0.5px; }
    .page-header .page-subtitle { font-size: 14px; color: rgba(255,255,255,0.9); margin: 0; }
</style>
