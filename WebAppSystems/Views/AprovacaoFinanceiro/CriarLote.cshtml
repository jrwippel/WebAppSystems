    }

    .cliente-footer {
        padding: 16px 24px;
        background: #f7fafc;
        display: flex;
        justify-content: center;
    }

    .btn-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: transparent;
        color: #667eea;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-toggle:hover {
        background: rgba(102, 126, 234, 0.1);
    }

    .action-bar {
        position: fixed;
        bottom: 20px;
        right: 20px;
        left: 20px;
        max-width: 1400px;
        margin: 0 auto;
        background: white;
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
