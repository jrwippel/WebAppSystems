    .filter-empty {
        text-align: center;
        padding: 30px;
        color: #718096;
        font-size: 14px;
        background: white;
        border-radius: 10px;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const PAGE_SIZE = 10;
    const state = { pendentes: { page: 1, filter: '' }, aprovados: { page: 1, filter: '' }, faturados: { page: 1, filter: '' } };

    // --- Filtro por cliente ---
    const filtroCliente = document.getElementById('filtroCliente');
    const btnLimpar = document.getElementById('btnLimparFiltro');

    filtroCliente.addEventListener('change', function() {
        const val = this.value;
        btnLimpar.style.display = val ? 'flex' : 'none';
        ['pendentes', 'aprovados', 'faturados'].forEach(tab => {
            state[tab].filter = val;
            state[tab].page = 1;
        });
        renderActiveTab();
    });

    btnLimpar.addEventListener('click', function() {
        filtroCliente.value = '';
        this.style.display = 'none';
        ['pendentes', 'aprovados', 'faturados'].forEach(tab => {
            state[tab].filter = '';
            state[tab].page = 1;
        });
        renderActiveTab();
    });

    // --- Abas ---
    const tabButtons = document.querySelectorAll('.tab-btn');
    tabButtons.forEach(button => {
        button.addEventListener('click', function() {
            tabButtons.forEach(btn => btn.classList.remove('active'));
            this.classList.add('active');
            document.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
            const target = document.getElementById('content-' + this.dataset.tab);
            if (target) target.style.display = 'block';
            renderTab(this.dataset.tab);
        });
    });

    // --- Paginação e filtro ---
    function getCards(tabId) {
        const list = document.querySelector(`#content-${tabId} .lotes-list`);
        if (!list) return [];
        return Array.from(list.querySelectorAll('.lote-card'));
    }

    function renderTab(tabId) {
        const s = state[tabId];
        const allCards = getCards(tabId);
        if (!allCards.length) return;

        // Filtrar por cliente
        const filtered = s.filter
            ? allCards.filter(card => {
                const h5 = card.querySelector('.lote-info h5');
                return h5 && h5.textContent.trim().toLowerCase().includes(s.filter.toLowerCase());
              })
            : allCards;

        // Esconder todos
        allCards.forEach(c => c.style.display = 'none');

        // Mostrar empty se nenhum resultado
        const container = document.querySelector(`#content-${tabId} .lotes-list`);
        let emptyMsg = container.querySelector('.filter-empty');
        if (!filtered.length) {
            if (!emptyMsg) {
                emptyMsg = document.createElement('div');
                emptyMsg.className = 'filter-empty';
                emptyMsg.innerHTML = '<i class="bi bi-search"></i> Nenhum lote encontrado para o cliente selecionado.';
                container.appendChild(emptyMsg);
            }
            emptyMsg.style.display = 'block';
            updatePagination(tabId, 0, 0);
            return;
        }
        if (emptyMsg) emptyMsg.style.display = 'none';

        // Paginar
        const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
        s.page = Math.min(s.page, totalPages);
        const start = (s.page - 1) * PAGE_SIZE;
        const end = start + PAGE_SIZE;
        filtered.forEach((card, i) => {
            card.style.display = (i >= start && i < end) ? '' : 'none';
        });

        updatePagination(tabId, filtered.length, totalPages);
    }

    function updatePagination(tabId, total, totalPages) {
        const s = state[tabId];
        let bar = document.querySelector(`#content-${tabId} .pagination-bar`);
        if (!bar) {
            bar = document.createElement('div');
            bar.className = 'pagination-bar';
            const content = document.getElementById(`content-${tabId}`);
            content.appendChild(bar);
        }

        if (totalPages <= 1) { bar.style.display = 'none'; return; }
        bar.style.display = 'flex';

        const start = (s.page - 1) * PAGE_SIZE + 1;
        const end = Math.min(s.page * PAGE_SIZE, total);

        let html = `<span class="pagination-info">Mostrando ${start}–${end} de ${total} lotes</span>`;
        html += `<div class="pagination-controls">`;
        html += `<button class="page-btn" onclick="goPage('${tabId}', ${s.page - 1})" ${s.page === 1 ? 'disabled' : ''}><i class="bi bi-chevron-left"></i></button>`;

        const range = pageRange(s.page, totalPages);
        range.forEach(p => {
            if (p === '...') html += `<span class="page-btn" style="cursor:default;">…</span>`;
            else html += `<button class="page-btn ${p === s.page ? 'active' : ''}" onclick="goPage('${tabId}', ${p})">${p}</button>`;
        });

        html += `<button class="page-btn" onclick="goPage('${tabId}', ${s.page + 1})" ${s.page === totalPages ? 'disabled' : ''}><i class="bi bi-chevron-right"></i></button>`;
        html += `</div>`;
        bar.innerHTML = html;
    }

    function pageRange(current, total) {
        if (total <= 7) return Array.from({length: total}, (_, i) => i + 1);
        if (current <= 4) return [1, 2, 3, 4, 5, '...', total];
        if (current >= total - 3) return [1, '...', total-4, total-3, total-2, total-1, total];
        return [1, '...', current-1, current, current+1, '...', total];
    }

    window.goPage = function(tabId, page) {
        state[tabId].page = page;
        renderTab(tabId);
        document.getElementById(`content-${tabId}`).scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    function renderActiveTab() {
        const active = document.querySelector('.tab-btn.active');
        if (active) renderTab(active.dataset.tab);
    }

    // Inicializar paginação na aba ativa
    renderActiveTab();
});

function confirmarExclusao(loteId, nomeCliente) {
    document.getElementById('nomeClienteExclusao').textContent = nomeCliente;
    const form = document.getElementById('formExcluirLote');
    form.action = '/AprovacaoFinanceiro/ExcluirLote/' + loteId;
    const modal = new bootstrap.Modal(document.getElementById('modalExcluirLote'));
    modal.show();
}
</script>
